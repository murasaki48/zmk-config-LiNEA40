#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6
#define layer_JIS 7
#define MARK_JIS 8

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E    &kp R                    &kp T                                    &kp Y             &kp U  &kp I                &kp O    &kp P
&kp A             &kp S         &kp D    &kp F                    &kp G                                    &kp H             &kp J  &kp K                &kp L    &lt 5 MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C    &kp V                    &kp B                                    &kp N             &kp M  &kp COMMA            &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp TAB  &mt LEFT_ALT LANGUAGE_2  &kp SPACE  &lt 2 ENTER    &kp BACKSPACE  &lt 3 LANGUAGE_1         &lt 6 RIGHT_BRACKET  &to 0    &lt 4 ESC
            >;
        };

        //1

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans    &trans
            >;
        };

        //2

        MARK {
            bindings = <
&kp LS(NUMBER_1)   &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)   &kp LS(N5)                           &kp RS(NUMBER_6)      &kp RS(N7)             &kp RS(N8)     &kp RS(N9)   &kp RS(N0)
&kp LS(BACKSLASH)  &kp LS(EQUAL)     &kp LS(GRAVE)     &kp LS(SEMICOLON)  &kp LS(SEMICOLON)                    &kp RS(LEFT_BRACKET)  &kp RS(RIGHT_BRACKET)  &kp RS(COMMA)  &kp RS(DOT)  &kp RS(SLASH)
&kp BACKSLASH      &kp EQUAL         &kp GRAVE         &kp SINGLE_QUOTE   &kp SEMICOLON                        &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp COMMA      &kp DOT      &kp SLASH
&trans             &trans            &trans            &trans             &trans             &trans    &trans  &trans                                       &trans         &trans       &trans
            >;
        };

        //3

        CURSOR {
            bindings = <
&kp KP_NUMLOCK           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MINUS                    &kp RA(PRINTSCREEN)  &kp HOME      &trans          &kp END          &kp KP_PLUS
&kp KP_MULTIPLY          &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS                     &kp PRINTSCREEN      &msc SCRL_UP  &kp UP_ARROW    &msc SCRL_DOWN   &kp DELETE
&mt LEFT_SHIFT KP_SLASH  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ENTER                    &kp UNDER            &kp LEFT      &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&mt LCTRL EQUAL          &kp KP_N0        &kp KP_DOT       &trans           &trans        &trans    &trans  &trans                             &kp DOT         &kp ENTER        &kp RC(RA(DEL))
            >;
        };

        //4

        FUNCTION {
            bindings = <
&trans  &kp F7  &kp F8  &kp F9  &kp F12                    &trans            &trans             &trans           &trans       &trans
&trans  &kp F4  &kp F5  &kp F6  &kp F11                    &kp RC(RG(LEFT))  &kp RC(RG(RIGHT))  &kp LS(LC(TAB))  &kp RC(TAB)  &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F10                    &kp RA(LEFT)      &kp RA(RIGHT)      &kp RC(F4)       &kp RA(F4)   &trans
&trans  &trans  &trans  &trans  &trans   &trans    &trans  &trans                               &trans           &trans       &trans
            >;
        };

        //5

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;
        };

        //6

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &to 0           &trans        &to 7         &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;
        };

        layer_JIS {
            bindings = <
&kp Q             &kp W         &kp E    &kp R                    &kp T                                    &kp Y             &kp U  &kp I                &kp O    &kp P
&kp A             &kp S         &kp D    &kp F                    &kp G                                    &kp H             &kp J  &kp K                &kp L    &lt 5 MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C    &kp V                    &kp B                                    &kp N             &kp M  &kp COMMA            &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp TAB  &mt LEFT_ALT LANGUAGE_2  &kp SPACE  &lt 8 ENTER    &kp BACKSPACE  &lt 3 LANGUAGE_1         &lt 6 RIGHT_BRACKET  &to 0    &lt 4 ESC
            >;
        };

        MARK_JIS {
            bindings = <
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)         &kp LS(NUMBER_3)  &kp LS(NUMBER_4)   &kp LS(N5)                              &kp RS(NUMBER_6)       &kp RS(N7)         &kp RS(N8)            &kp RS(N9)     &kp RS(N0)
&trans            &kp LS(INTERNATIONAL_3)  &kp LS(INT_RO)    &kp LS(SEMICOLON)  &kp LS(SINGLE_QUOTE)                    &kp RS(RIGHT_BRACKET)  &kp RS(BACKSLASH)  &kp RS(LEFT_BRACKET)  &kp RS(EQUAL)  &trans
&trans            &kp INTERNATIONAL_3      &kp INT_RO        &kp SEMICOLON      &kp SQT                                 &kp RIGHT_BRACKET      &kp BACKSLASH      &kp LEFT_BRACKET      &kp EQUAL      &trans
&trans            &trans                   &trans            &trans             &trans                &trans    &trans  &trans                                    &trans                &trans         &trans
            >;
        };
    };
};
